# Use local for local demos. Use public-demo for mock-only public demos.
APP_ENV=local
APP_ADMIN_TOKEN=123
APP_METRICS_TOKEN=metrics-123
APP_WORKSPACE_ID=default
APP_UPLOADER_TOKEN=uploader-123
APP_REVIEWER_TOKEN=reviewer-123
UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_BYTES=15728640

# Local and controlled synthetic demos use the signature guard. Production refuses
# to start unless MALWARE_SCANNER_BACKEND=clamav and scanning is enabled.
MALWARE_SCANNING_ENABLED=true
MALWARE_SCANNER_BACKEND=signature
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Admin-only retention operations use these windows. Run a dry-run before purge.
DOCUMENT_RETENTION_DAYS=90
PARSER_CACHE_RETENTION_HOURS=24

# Hosted modes require unique tokens with at least 24 non-default characters.
# Public demo mode requires all three role credentials and mock AI providers.

# Document object storage boundary. The local profile uses private storage first.
# Cloudflare R2 is the hosted target through its S3-compatible API.
# MinIO can use the same variables for fully local development.
DOCUMENT_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Persistence backend for metadata,
# job, audit, review, extraction, and benchmark history storage, not document
# object storage.
STORAGE_BACKEND=sqlite
SQLITE_PATH=/data/doc_intel.sqlite3

# Intended production database target. Not used by the runtime adapter until
# the Postgres repository slice is implemented; kept here to make the target
# configuration explicit.
DATABASE_URL=postgresql://docintel:docintel@db:5432/docintel

PARSER_PROVIDER=mock
EXTRACTOR_PROVIDER=mock

# Optional real OCR adapter. Keep mock for tests and offline demos.
MISTRAL_API_KEY=
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_ALLOWED_HOSTS=api.mistral.ai

# Optional structured extraction adapter. Keep EXTRACTOR_PROVIDER=mock for tests.
EXTRACTOR_API_KEY=
EXTRACTOR_ENDPOINT=https://api.openai.com/v1/chat/completions
EXTRACTOR_MODEL=gpt-5.4-mini-2026-03-17
EXTRACTOR_ALLOWED_HOSTS=api.openai.com

# Safety guard for paid benchmark runs.
BENCHMARK_REAL_PROVIDER_MAX_DOCUMENTS=3

# Processing retry guard for transient provider failures.
MAX_PROCESSING_ATTEMPTS=3
PROVIDER_TIMEOUT_SECONDS=60
# Reclaim a RUNNING job only after the prior worker has exceeded this lease.
WORKER_JOB_LEASE_SECONDS=300

# Optional sandbox email delivery.
EMAIL_PROVIDER=mock
EMAIL_SANDBOX_MODE=true
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_TEST_RECIPIENT=

# Credential-free accounting export is available as CSV download.
ACCOUNTING_PROVIDER=csv_download
ACCOUNTING_SANDBOX_MODE=true

# Docker worker loop polling interval.
WORKER_POLL_SECONDS=5
