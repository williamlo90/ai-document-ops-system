# Use local for local demos. Use public-demo for mock-only public demos.
APP_ENV=local
APP_ADMIN_TOKEN=123
APP_METRICS_TOKEN=metrics-123
APP_WORKSPACE_ID=default
APP_UPLOADER_TOKEN=uploader-123
APP_REVIEWER_TOKEN=reviewer-123
UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_BYTES=15728640

# Local and controlled synthetic demos use the signature guard. Production refuses
# to start unless MALWARE_SCANNER_BACKEND=clamav and scanning is enabled.
MALWARE_SCANNING_ENABLED=true
MALWARE_SCANNER_BACKEND=signature
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Admin-only retention operations use these windows. Run a dry-run before purge.
DOCUMENT_RETENTION_DAYS=90
PARSER_CACHE_RETENTION_HOURS=24

# Hosted modes require unique tokens with at least 24 non-default characters.
# Public demo mode requires all three role credentials and mock AI providers.

# Document object storage boundary. The local profile uses private storage first.
# Cloudflare R2 is the hosted target through its S3-compatible API.
# MinIO can use the same variables for fully local development.
DOCUMENT_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Azure Blob document storage. Production uses ACCOUNT_URL with
# DefaultAzureCredential/Managed Identity and leaves CONNECTION_STRING empty.
# Local Azurite may use AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# when the application runs directly on the host.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_STORAGE_TIMEOUT_SECONDS=30
AZURE_STORAGE_CREATE_CONTAINER=false

# Processing queue: keep "none" for the polling fallback, or use
# "azure-service-bus" with either Managed Identity (namespace) or a local
# emulator connection string. Queue messages contain identifiers only.
PROCESSING_QUEUE_BACKEND=none
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_NAME=document-processing
AZURE_SERVICE_BUS_TIMEOUT_SECONDS=30
AZURE_SERVICE_BUS_MAX_LOCK_RENEWAL_SECONDS=300
AZURE_SERVICE_BUS_MAX_DELIVERY_COUNT=5

# Optional local Service Bus emulator profile. Set these only in an ignored
# .env after reviewing and accepting Microsoft's emulator and SQL Server EULAs.
SERVICE_BUS_EMULATOR_ACCEPT_EULA=N
SERVICE_BUS_EMULATOR_SQL_PASSWORD=
SERVICE_BUS_EMULATOR_AMQP_PORT=5672
SERVICE_BUS_EMULATOR_HTTP_PORT=5300

# Persistence backend for metadata,
# job, audit, review, extraction, and benchmark history storage, not document
# object storage. Hosted modes refuse the disposable memory backend.
STORAGE_BACKEND=sqlite
SQLITE_PATH=/data/doc_intel.sqlite3

# PostgreSQL runtime target. Set STORAGE_BACKEND=postgres after applying
# backend/migrations/postgres with scripts/postgres_migrate.py.
DATABASE_URL=postgresql://docintel:docintel@postgres-target:5432/docintel
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

PARSER_PROVIDER=mock
EXTRACTOR_PROVIDER=mock

# Optional real OCR adapter. Keep mock for tests and offline demos.
MISTRAL_API_KEY=
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_ALLOWED_HOSTS=api.mistral.ai

# Optional structured extraction adapter. Keep EXTRACTOR_PROVIDER=mock for tests.
EXTRACTOR_API_KEY=
EXTRACTOR_ENDPOINT=https://api.openai.com/v1/chat/completions
EXTRACTOR_MODEL=gpt-5.4-mini-2026-03-17
EXTRACTOR_ALLOWED_HOSTS=api.openai.com

# Safety guard for paid benchmark runs.
BENCHMARK_REAL_PROVIDER_MAX_DOCUMENTS=3

# Processing retry guard for transient provider failures.
MAX_PROCESSING_ATTEMPTS=3
PROVIDER_TIMEOUT_SECONDS=60
# Reclaim a RUNNING job only after the prior worker has exceeded this lease.
WORKER_JOB_LEASE_SECONDS=300
# Retry transient provider failures with bounded exponential backoff and per-job jitter.
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300

# Optional sandbox email delivery.
EMAIL_PROVIDER=mock
EMAIL_SANDBOX_MODE=true
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_TEST_RECIPIENT=

# Credential-free accounting export is available as CSV download.
# Set ACCOUNTING_PROVIDER=erpnext only after provisioning the isolated sandbox below.
ACCOUNTING_PROVIDER=csv_download
ACCOUNTING_SANDBOX_MODE=true

# Local ERPNext sandbox. API credentials belong only in the ignored .env file.
# Administrator access is used only by provisioning and targeted smoke-cleanup scripts.
# The application never loads or uses this password.
ERPNEXT_BASE_URL=http://127.0.0.1:8080
ERPNEXT_SITE=frontend
ERPNEXT_ADMIN_PASSWORD=
ERPNEXT_API_USER=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT_SECONDS=30
ERPNEXT_ALLOWED_HOSTS=127.0.0.1,localhost

# Docker worker loop polling interval.
WORKER_POLL_SECONDS=5
WORKER_MAX_IDLE_POLL_SECONDS=30
