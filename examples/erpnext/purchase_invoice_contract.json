{
  "schema_version": 3,
  "adapter_name": "erpnext-purchase-invoice-draft",
  "provider": "erpnext",
  "resource": {
    "create_method": "POST",
    "create_path": "/api/resource/Purchase%20Invoice",
    "lookup_method": "GET",
    "lookup_doctype": "Purchase Invoice",
    "allowed_operations": [
      "create_draft",
      "read_draft",
      "lookup_by_delivery_key"
    ],
    "forbidden_operations": ["submit", "post", "pay", "cancel", "delete"]
  },
  "safety": {
    "required_application_role": "admin",
    "required_document_status": "approved",
    "required_review_status": "approved",
    "required_review_evidence": ["reviewed_by", "reviewed_at"],
    "required_validation_errors": 0,
    "provider_docstatus": 0,
    "success_copy": "ERP draft created"
  },
  "identity": {
    "delivery_key_algorithm": "erpnext:{sha256(workspace_id + NUL + document_id + NUL + review_task_id)}",
    "payload_hash_algorithm": "sha256(canonical_mapped_payload_json)",
    "provider_delivery_key_field": "custom_invoice_review_delivery_key",
    "provider_document_id_field": "custom_invoice_review_document_id",
    "provider_payload_hash_field": "custom_invoice_review_payload_hash"
  },
  "benchmark_mapping": {
    "company": "Invoice Review Assisted Benchmark",
    "payable_accounts": {
      "USD": "Creditors - IRA",
      "EUR": "Creditors EUR - IRA"
    },
    "expense_account": "Professional Services - IRA",
    "item_code": "BENCH-PROF-SVC",
    "item_name": "Professional Services",
    "uom": "Nos",
    "posting_date_policy": "trial_date",
    "currency_rates": {
      "USD": 1.0,
      "EUR@2026-07-03": 1.1
    },
    "tax_templates": {
      "0": null,
      "10": "Benchmark Input Tax 10% - IRA",
      "20": "Benchmark Input Tax 20% - IRA"
    }
  },
  "request_example": {
    "doctype": "Purchase Invoice",
