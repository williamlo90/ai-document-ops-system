    "bill_no": "AC-1001",
    "bill_date": "2026-07-01",
    "due_date": "2026-07-31",
    "currency": "USD",
    "conversion_rate": 1.0,
    "credit_to": "Creditors - IRA",
    "taxes_and_charges": "Benchmark Input Tax 10% - IRA",
    "taxes": [
      {
        "category": "Total",
        "add_deduct_tax": "Add",
        "charge_type": "On Net Total",
        "account_head": "Benchmark Input Tax - IRA",
        "description": "Benchmark input tax 10%",
        "rate": 10.0
      }
    ],
    "items": [
      {
        "item_code": "BENCH-PROF-SVC",
        "item_name": "Professional Services",
        "description": "Invoice AC-1001",
        "qty": 1,
        "uom": "Nos",
        "conversion_factor": 1,
        "rate": 100.0,
        "expense_account": "Professional Services - IRA"
      }
    ],
    "custom_invoice_review_delivery_key": "erpnext:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "custom_invoice_review_document_id": "11111111-1111-4111-8111-111111111111",
    "custom_invoice_review_payload_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "docstatus": 0
  },
  "required_response_fields": [
    "name",
    "doctype",
    "docstatus",
    "company",
    "supplier",
    "bill_no",
    "currency",
    "grand_total",
    "custom_invoice_review_delivery_key",
    "custom_invoice_review_document_id",
    "custom_invoice_review_payload_hash",
    "creation",
    "modified"
  ],
  "response_invariants": {
    "doctype": "Purchase Invoice",
    "docstatus": 0,
    "company": "Invoice Review Assisted Benchmark",
    "identity_fields_must_match_request": true,
    "business_fields_must_match_approved_payload": true
  },
  "delivery_states": [
    "ready",
