{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/invoice-review/manifest-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "status": {
      "enum": ["planned", "sealed"]
    },
    "label_provenance": {
      "const": "developer/AI-assisted synthetic"
    },
    "cohorts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "split": {
            "enum": ["development", "quality_holdout", "time_study"]
          },
          "planned_families": {
            "type": "integer",
            "minimum": 1
          },
          "actual_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "families": {
                "type": "integer",
                "minimum": 0
              },
              "invoices": {
                "type": "integer",
                "minimum": 0
              },
              "lines": {
                "type": "integer",
                "minimum": 0
              },
              "duplicate_pairs": {
                "type": "integer",
                "minimum": 0
              },
              "supplier_layouts": {
                "type": "integer",
                "minimum": 0
              },
              "rule_revisions": {
                "type": "integer",
                "minimum": 0
              },
              "erp_operations": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "families",
              "invoices",
              "lines",
              "duplicate_pairs",
              "supplier_layouts",
              "rule_revisions",
              "erp_operations"
            ]
          },
          "families": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "family_id": {
                  "type": "string",
                  "minLength": 1
                },
                "layout_family_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "duplicate_group_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "families": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "invoices": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "lines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "duplicate_pairs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "supplier_layouts": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rule_revisions": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "erp_operations": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "families",
                    "invoices",
                    "lines",
                    "duplicate_pairs",
                    "supplier_layouts",
                    "rule_revisions",
                    "erp_operations"
                  ]
                },
                "artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "role": {
                        "enum": [
                          "source_pdf",
                          "invoice_labels",
                          "procurement",
                          "timeline",
                          "expected_match",
                          "expected_posting",
                          "corrections"
                        ]
                      }
                    },
                    "required": ["path", "sha256", "role"]
                  }
                }
              },
              "required": [
                "family_id",
                "layout_family_ids",
                "duplicate_group_ids",
                "counts",
                "artifacts"
              ]
            }
          }
        },
        "required": ["split", "planned_families", "actual_counts", "families"]
      }
    },
    "freeze": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "sealed_at": {
              "type": "string",
              "format": "date-time"
            },
            "model_version": {
              "type": "string",
              "minLength": 1
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evaluator_version": {
              "type": "string",
              "minLength": 1
            },
            "oracle_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "commit",
            "sealed_at",
            "model_version",
            "prompt_sha256",
            "config_sha256",
            "evaluator_version",
            "oracle_sha256"
          ]
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "status",
    "label_provenance",
    "cohorts",
    "freeze"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "sealed"
          }
        }
      },
      "then": {
        "properties": {
          "freeze": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "sealed_at": {
                "type": "string",
                "format": "date-time"
              },
              "model_version": {
                "type": "string",
                "minLength": 1
              },
              "prompt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evaluator_version": {
                "type": "string",
                "minLength": 1
              },
              "oracle_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "commit",
              "sealed_at",
              "model_version",
              "prompt_sha256",
              "config_sha256",
              "evaluator_version",
              "oracle_sha256"
            ]
          },
          "cohorts": {
            "items": {
              "properties": {
                "families": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
