{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,json,md}\" \"../*.md\" \"../docs/**/*.md\" \"../backend/README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,json,md}\" \"../*.md\" \"../docs/**/*.md\" \"../backend/README.md\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "capture:portfolio": "set CAPTURE_PORTFOLIO=1&& playwright test e2e/portfolio.spec.ts --project=desktop --workers=1",
    "capture:demo": "set CAPTURE_DEMO=1&& playwright test e2e/demo-video.spec.ts --project=desktop --workers=1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.21.0",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "axe-core": "4.12.1",
    "jsdom": "29.1.1",
    "oxlint": "1.69.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
