{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "audit": "node scripts/audit-dependencies.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,json,md}\" \"../*.md\" \"../docs/**/*.md\" \"../backend/README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,json,md}\" \"../*.md\" \"../docs/**/*.md\" \"../backend/README.md\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config=playwright.fullstack.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "capture:portfolio": "set CAPTURE_PORTFOLIO=1&& playwright test e2e/portfolio.spec.ts --project=desktop --workers=1",
    "capture:demo": "set CAPTURE_DEMO=1&& playwright test e2e/demo-video.spec.ts --project=desktop --workers=1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "lucide-react": "1.47.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "29.1.1",
    "oxlint": "1.83.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
